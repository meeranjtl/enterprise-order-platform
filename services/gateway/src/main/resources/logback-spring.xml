<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase 11: JSON structured logging. Standalone (not shared-library's
  logback-json-base.xml) — gateway is reactive and must never depend on
  shared-library (servlet-based).

  LogstashEncoder includes every MDC entry by default, so correlationId
  (CorrelationIdFilter) and traceId/spanId (Micrometer Tracing's Brave
  instrumentation) show up as JSON fields — both rely on the same reactor
  Context -> MDC propagation already enabled by
  Hooks.enableAutomaticContextPropagation() in GatewayApplication.
-->
<configuration>
    <springProperty scope="context" name="applicationName" source="spring.application.name" defaultValue="gateway"/>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${applicationName}"}</customFields>
        </encoder>
    </appender>

    <logger name="com.enterprise.order.gateway" level="INFO"/>
    <logger name="org.springframework.cloud.gateway" level="INFO"/>
    <logger name="io.github.resilience4j" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
</configuration>
